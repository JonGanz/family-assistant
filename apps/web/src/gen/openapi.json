  "components": {
    "schemas": {
      "ActorView": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "device": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DeviceDto"
              }
            ]
          },
          "kind": {
            "type": "string",
            "description": "`user`, `device` or `elevated_device`."
          },
          "member": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      },
      "CreateAccountReq": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "CreateMemberReq": {
        "type": "object",
        "required": [
          "display_name",
          "role"
        ],
        "properties": {
          "avatar": {
            "type": [
              "string",
              "null"
            ]
          },
          "birthdate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "color": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": "string"
          },
          "grade": {
            "type": [
              "string",
              "null"
            ]
          },
          "hobbies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "interests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "role": {
            "type": "string"
          }
        }
      },
      "DeviceDto": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "revoked"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string"
          },
          "last_seen": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "revoked": {
            "type": "boolean"
          }
        }
      },
      "ElevateReq": {
        "type": "object",
        "required": [
          "member_id",
          "pin"
        ],
        "properties": {
          "member_id": {
            "type": "string",
            "format": "uuid"
          },
          "pin": {
            "type": "string"
          }
        }
      },
      "ElevateResp": {
        "type": "object",
        "required": [
          "expires_at"
        ],
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HouseholdDto": {
        "type": "object",
        "required": [
          "id",
          "name",
          "tz",
          "meal_plan_horizon_weeks",
          "dashboard_completion_override"
        ],
        "properties": {
          "dashboard_completion_override": {
            "type": "boolean"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "location": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Location"
              }
            ]
          },
          "meal_plan_horizon_weeks": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "tz": {
            "type": "string"
          }
        }
      },
      "Location": {
        "type": "object",
        "required": [
          "lat",
          "lon",
          "label"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "format": "double"
          },
          "lon": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "LoginReq": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "LoginResp": {
        "type": "object",
        "required": [
          "member_id",
          "role",
          "expires_at"
        ],
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "member_id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "required": [
          "actor",
          "household"
        ],
        "properties": {
          "actor": {
            "$ref": "#/components/schemas/ActorView"
          },
          "household": {
            "$ref": "#/components/schemas/HouseholdDto"
          }
        }
      },
