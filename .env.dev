# Local development defaults (no secrets). Loaded by `just`; `source` it for plain shells:
#   set -a; . ./.env.dev; set +a
DATABASE_URL=postgres://fa:fa@127.0.0.1:55432/fa
FA_BIND_ADDR=127.0.0.1:8080
FA_PUBLIC_BASE_URL=http://localhost:8080
FA_COOKIE_SECURE=false
FA_WEB_DIST_DIR=apps/web/dist
# Created by `just dev-key` / scripts/dev-key.sh; .dev/ is git-ignored.
FA_MASTER_KEY_PATH=.dev/master.key
FA_LOG_FORMAT=pretty
# Calendar feeds on plain http (a LAN CalDAV server, the e2e fixtures) are allowed in development.
FA_ALLOW_HTTP_FEEDS=true
# The ICS, CalDAV and mail dev servers sit on 127.0.0.1; the SSRF guard (C-05) refuses private hosts otherwise.
FA_ALLOW_PRIVATE_HOSTS=true
# Notifications: the dev ntfy from deploy/compose.dev.yaml (`docker compose -f deploy/compose.dev.yaml up -d --wait`).
FA_NTFY_URL=http://127.0.0.1:18090
# Optional: a different weather provider or a local stub (default https://api.open-meteo.com).
# FA_OPEN_METEO_URL=http://127.0.0.1:18091
# Optional: Google OAuth (see deploy/README.md). Uncomment and fill in to enable Google calendars.
# FA_PUBLIC_URL=http://localhost:8080
# FA_GOOGLE_CLIENT_ID=
# FA_GOOGLE_CLIENT_SECRET=
# Mail: the dev GreenMail (`just dev-mail`) speaks plain IMAP on 127.0.0.1:13143. Plain IMAP is refused unless
# this is set (local testing only; leave it off if you only use real mailboxes over TLS).
# FA_ALLOW_PLAIN_IMAP=true
