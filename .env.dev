# Local development defaults (no secrets). Loaded by `just`; `source` it for plain shells:
#   set -a; . ./.env.dev; set +a
DATABASE_URL=postgres://fa:fa@127.0.0.1:55432/fa
FA_BIND_ADDR=127.0.0.1:8080
FA_PUBLIC_BASE_URL=http://localhost:8080
FA_COOKIE_SECURE=false
FA_WEB_DIST_DIR=apps/web/dist
# Created by `just dev-key` / scripts/dev-key.sh; .dev/ is git-ignored.
FA_MASTER_KEY_PATH=.dev/master.key
FA_LOG_FORMAT=pretty
