# Copy to deploy/.env and edit. Never commit the real file.

# Image tag of ghcr.io/<owner>/fa-server to run (a release tag such as 0.1.0, or latest).
FA_VERSION=latest
# GHCR owner of the published image.
FA_IMAGE_OWNER=owner

# Postgres credentials. The database is not published to the host.
POSTGRES_USER=fa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fa

# Path on the host to the 32-byte master key file (mode 0400). Back it up offline.
FA_MASTER_KEY_FILE=./fa_master_key

# Host directory for database backups, e.g. an NFS/SMB mount of your NAS.
BACKUP_DIR=/mnt/nas/fa-backups

# Public HTTPS URL users reach (the tailscale serve hostname). Used for cookies, OAuth redirects, pairing URLs.
FA_PUBLIC_BASE_URL=https://fa-host.example-tailnet.ts.net
# Set to false only for plain-http local testing.
FA_COOKIE_SECURE=true

# Base of the Google OAuth redirect (`<this>/api/v1/oauth/google/callback`). Must be https unless
# FA_ALLOW_HTTP_FEEDS=true. Default: FA_PUBLIC_BASE_URL. Needed only with a Google client.
# FA_PUBLIC_URL=https://fa-host.example-tailnet.ts.net
# Google OAuth client (see deploy/README.md, "Google OAuth client"). Leave unset to hide Google
# sources in the UI; ICS and CalDAV work without it.
# FA_GOOGLE_CLIENT_ID=
# FA_GOOGLE_CLIENT_SECRET=
# Weather provider base URL (default shown). Point it at a stub or a self-hosted Open-Meteo.
# FA_OPEN_METEO_URL=https://api.open-meteo.com
# Accept plain http for calendar feeds and the OAuth redirect (LAN CalDAV, local testing). Default false.
# FA_ALLOW_HTTP_FEEDS=false
# Host ports the compose file publishes on 127.0.0.1 (defaults shown).
# FA_HOST_API_PORT=8080
# FA_HOST_NTFY_PORT=8090

# Reverse proxies whose X-Forwarded-For is trusted for the client IP (login rate limiting).
# Default (unset): 127.0.0.0/8,::1/128,172.16.0.0/12 — loopback + Docker bridge, i.e. `tailscale serve`
# on the host. Set to an empty value to trust no proxy.
# FA_TRUSTED_PROXIES=127.0.0.0/8,::1/128,172.16.0.0/12
# trace, debug, info, warn or error.
FA_LOG_LEVEL=info
# json or pretty.
FA_LOG_FORMAT=json

# Public URL of ntfy as phones reach it (via tailscale serve).
NTFY_BASE_URL=https://fa-host.example-tailnet.ts.net:8443

# Address the gpu-profile Ollama binds to on the host. Use 0.0.0.0 on a GPU node that the core node must reach over the LAN or tailnet.
OLLAMA_BIND=127.0.0.1
