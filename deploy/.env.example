# Family Assistant deployment settings. Copy this file to deploy/.env and edit it (deploy/README.md,
# step 4). Never commit the real file: it holds the database password.
#
# Run every `docker compose` command from the deploy/ folder. Compose then reads this file
# by itself, so no --env-file or -f flags are needed.

# ---- Compose (leave as is) ---------------------------------------------------------------------
COMPOSE_FILE=compose.example.yaml
# Prefix of the container and volume names. Don't change it after the first start: the
# database volume is named after it.
COMPOSE_PROJECT_NAME=family-assistant

# ---- Required: fill these in -------------------------------------------------------------------
# A long random password for the database, for example the output of: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# The app's address on your tailnet, from step 2 (https://<machine>.<tailnet>.ts.net, no trailing slash).
FA_PUBLIC_BASE_URL=https://fa-host.example-tailnet.ts.net
# The same address on port 8443: where phones reach ntfy for notifications.
NTFY_BASE_URL=https://fa-host.example-tailnet.ts.net:8443

# ---- Files on the server (the defaults are fine) -----------------------------------------------
# The 32-byte master key (step 4). Relative paths are relative to this deploy/ folder.
FA_MASTER_KEY_FILE=./secrets/fa_master_key
# Where the nightly database backups go. A NAS mount (NFS/SMB) is a good choice, e.g. /mnt/nas/fa-backups.
BACKUP_DIR=./backups

# ---- Image (the defaults are fine) -------------------------------------------------------------
# `docker compose up -d --build` builds the image from this checkout and tags it with these.
# To pull a published release instead, set the GitHub owner and a release tag (such as 0.3.0).
FA_IMAGE_OWNER=jonganz
FA_VERSION=latest

# ---- Database (the defaults are fine) ----------------------------------------------------------
POSTGRES_USER=fa
POSTGRES_DB=fa

# ---- Optional: Google calendars and Gmail (deploy/README.md, "Google sign-in") ----------------
# Leave unset to hide Google in the app. ICS links, CalDAV and IMAP mail work without it.
# FA_GOOGLE_CLIENT_ID=
# FA_GOOGLE_CLIENT_SECRET=
# Base of the Google sign-in redirect (`<this>/api/v1/oauth/google/callback`). Default: FA_PUBLIC_BASE_URL.
# FA_PUBLIC_URL=https://fa-host.example-tailnet.ts.net

# ---- Optional: notifications -------------------------------------------------------------------
# Where the app sends notifications. The default is the ntfy service in the compose file. Set it
# empty (FA_NTFY_URL=) to turn notifications off.
# FA_NTFY_URL=http://ntfy:80
# Write token, needed only if you turn on ntfy access control (deploy/README.md).
# FA_NTFY_TOKEN=
# iPhones: the iOS ntfy app gets instant notifications from a self-hosted server only through
# ntfy.sh, which relays a wake-up message containing only the message ID, never the text.
# NTFY_UPSTREAM_BASE_URL=https://ntfy.sh

# ---- Optional: other settings ------------------------------------------------------------------
# Accept plain http for calendar feeds (a CalDAV server on your LAN). Default false.
# FA_ALLOW_HTTP_FEEDS=false
# Weather provider (default shown). Point it at a self-hosted Open-Meteo if you run one.
# FA_OPEN_METEO_URL=https://api.open-meteo.com
# Ports on the server (127.0.0.1 only) that `tailscale serve` forwards to. Change them if taken.
# FA_HOST_API_PORT=8080
# FA_HOST_NTFY_PORT=8090
# Reverse proxies whose X-Forwarded-For is trusted for the client IP (login rate limiting).
# Default: loopback and the Docker bridge, which is right for `tailscale serve` on the server.
# FA_TRUSTED_PROXIES=127.0.0.0/8,::1/128,172.16.0.0/12
# Set to false only for plain-http testing on the server itself.
# FA_COOKIE_SECURE=true
# trace, debug, info, warn or error; json or pretty.
FA_LOG_LEVEL=info
FA_LOG_FORMAT=json

# ---- Optional: GPU machine (profile gpu) -------------------------------------------------------
# Address the gpu-profile Ollama binds to. Use 0.0.0.0 on a GPU machine the server reaches over the LAN or tailnet.
# OLLAMA_BIND=127.0.0.1

# ---- Tests only: never set these on a real deployment ------------------------------------------
# FA_GOOGLE_API_BASE points Gmail and Google Calendar calls at a stub. FA_ALLOW_PLAIN_IMAP
# (IMAP without TLS) and FA_IMAP_TLS_INSECURE (skip IMAPS certificate checks) exist for tests and
# the local GreenMail. The compose file does not pass the IMAP ones through.
