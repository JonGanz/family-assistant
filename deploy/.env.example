# Every variable is optional: `docker compose up -d` works without a .env file.
# Needs Docker Compose 2.23.1 or newer (inline `configs: content:` in compose.yaml).

# ---- Ports -------------------------------------------------------------------
# Host interface the app and ntfy publish on (127.0.0.1 keeps them local-only).
# FA_HTTP_HOST_IP=0.0.0.0
# Host port of the web app and API.
# FA_HTTP_PORT=8080
# Host port of ntfy.
# FA_NTFY_PORT=8090

# ---- Version -----------------------------------------------------------------
# Release image tag of ghcr.io/jonganz/fa-server (pin it for repeatable installs).
# FA_VERSION=latest

# ---- Backups -----------------------------------------------------------------
# Host folder for database backups; unset uses the Docker volume fa-backups.
# BACKUP_DIR=/srv/fa-backups

# ---- Tailscale (profile `tailscale`) -----------------------------------------
# Auth key from the Tailscale admin console (needed on the first start only).
# TS_AUTHKEY=
# Machine name on the tailnet; the HTTPS address becomes <name>.<tailnet>.ts.net.
# TS_HOSTNAME=family

# ---- Advanced overrides ------------------------------------------------------
# Log level: error, warn, info, debug, trace.
# FA_LOG_LEVEL=info
# Public address of ntfy for phones (set it to the address phones reach).
# NTFY_BASE_URL=http://localhost:8090
# iPhones only: relay wake-ups through ntfy.sh.
# NTFY_UPSTREAM_BASE_URL=https://ntfy.sh
# Interface the Ollama port (profile gpu) binds to.
# OLLAMA_BIND=127.0.0.1
