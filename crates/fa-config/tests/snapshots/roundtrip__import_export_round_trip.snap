---
source: crates/fa-config/tests/roundtrip.rs
expression: first
---
schema_version = 1

[household]
name = "The Example Family"
tz = "America/New_York"
units = "metric"
calendar_past_days = 30
calendar_future_days = 400
weather_retention_days = 7
private_events_as_busy = true
dashboard_completion_override = true
now_list_size = 7
quiet_from = "21:00"
quiet_until = "07:00"
currency = "USD"
disabled_signals = []
bill_lead_days = 3

[household.location]
label = "Springfield (fictional)"
lat = 40.0
lon = -75.0

[household.now_weights]
due = 1.0
flag = 0.5
weather = 0.5

[household.gender_terms]
female = [
    "girls",
    "girls'",
    "girl's",
]
male = [
    "boys",
    "boys'",
    "boy's",
]

[household.events]
auto_write = false
extract_threshold = 0.9
route_threshold = 0.9

[household.inbox]
task_expiry_days = 14
contact_expiry_days = 14

[[members]]
key = "alex"
display_name = "Alex"
role = "adult"
birthdate = "1985-04-12"
interests = [
    "cycling",
    "board games",
]
hobbies = ["woodworking"]
responsibilities = [
    "finances",
    "school pickups on Mondays",
]

[[members]]
key = "sam"
display_name = "Sam"
role = "adult"
birthdate = "1987-09-30"
interests = [
    "gardening",
    "podcasts",
]
hobbies = ["pottery"]
responsibilities = [
    "meal planning",
    "medical appointments",
]

[[members]]
key = "riley"
display_name = "Riley"
role = "child"
birthdate = "2016-06-03"
grade = "3"
interests = [
    "dinosaurs",
    "soccer",
]
hobbies = ["drawing"]
responsibilities = [
    "feed the cat",
    "pack school bag",
]
aliases = ["Ri"]
gender = "female"
relevance_tags = ["soccer"]

[[members.enrollments]]
org = "Example Elementary"
grade = "3"
class = "3B"
from = "2026-09-01"
contacts = ["teacher@example.edu"]

[[members]]
key = "jordan"
display_name = "Jordan"
role = "child"
birthdate = "2022-02-18"
interests = [
    "trucks",
    "music",
]
hobbies = []
responsibilities = ["tidy toys"]
gender = "male"

# ICS URL is not exported: paste it again in Settings.
[[calendar_sources]]
key = "school-calendar"
kind = "ics"
name = "School calendar"
owner = "alex"
poll_minutes = 60
enabled = false

[[calendar_sources.calendars]]
remote_id = "ics"
name = "School"
enabled = false
color = "#4c8bf5"
members = ["riley"]

[[weather_rules]]
name = "Cold morning coats"
condition = "min(temp_c, tonight) < 2"
action = "alert"
severity = "info"
message = "Frosty start: coats and hats for school."
status = "active"

[retention.mail]
content_policy = "keep_for_learning"
examples_per_category = 200
max_pending_days = 14

[[orgs]]
name = "Example Elementary"
kind = "school"
domains = ["example.edu"]
senders = ["office@example.edu"]
ics_calendar = "school-calendar/ics"
default_calendar = "school-calendar/ics"
contact_mode = "suggest"

[[orgs.contacts]]
name = "Ms. Teacher"
email = "teacher@example.edu"
role = "teacher"

[[orgs]]
name = "Example Utilities"
kind = "biller"
domains = ["example.com"]
senders = ["billing@example.com"]
contact_mode = "suggest"

[orgs.bill_template]
amount = 'Amount due:\s*(\$[0-9.,]+)'
due = 'Due date:\s*([A-Za-z]+ [0-9]{1,2}, [0-9]{4})'
account = 'Account ending in\s*([0-9]{4})'
